# ════════════════════════════════════════════════════════════
#  MCQ Portal — Environment Variable Template
#  Copy to .env and fill in real values. Never commit .env.
# ════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────
FLASK_APP=run.py
# Set to "production" on the server. "development" enables debug mode & relaxes cookie security.
FLASK_ENV=production

# Cryptographically random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# ── JWT (Flask-JWT-Extended) ──────────────────────────────────
# Separate secret for the internal access-token cookies
JWT_SECRET_KEY=replace-with-another-random-64-char-hex-string

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (Supabase, Railway, Neon, etc.)
DATABASE_URL=postgresql://username:password@host:5432/dbname
# For Supabase transaction-mode pooler:
# DATABASE_URL=postgresql://postgres.ref:password@aws-region.pooler.supabase.com:6543/postgres

# ── SSO (padikkunnundo.app) ───────────────────────────────────
# Must match JWT_SECRET on the Padikkunnundo issuer exactly
JWT_SECRET=replace-with-shared-sso-secret

# URL of the Padikkunnundo main site; users without a valid SSO token are redirected here
PADIKKUNNUNDO_URL=https://padikkunnundo.app

# ── Admin Account ─────────────────────────────────────────────
ADMIN_USERNAME=your_secure_admin_username
ADMIN_PASSWORD=your_super_secure_password

# ── Caching (optional) ────────────────────────────────────────
# Default: SimpleCache (in-process, single instance). No extra config needed.
# For multi-worker deployments, switch to RedisCache:
#   CACHE_TYPE=RedisCache
#   REDIS_URL=redis://your-redis-host:6379/0
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
